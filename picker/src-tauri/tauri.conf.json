{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Model Dispatch Picker",
  "version": "0.1.0",
  "identifier": "dev.lauritztimm.opencodemodeldispatch",
  "build": {
    "beforeDevCommand": "bun run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Model Dispatch",
        "width": 680,
        "height": 500,
        "center": true,
        "decorations": false,
        "visible": false,
        "shadow": true,
        "transparent": true,
        "theme": "Dark",
        "resizable": true,
        "alwaysOnTop": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
